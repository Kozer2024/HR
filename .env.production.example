# Copy to .env.production on the VPS. Replace every placeholder; never commit the real file.
DOMAIN=your-domain.example
DB_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Администратор
TELEGRAM_BOT_TOKEN=

# Google Drive OAuth values. Leave empty to store new uploads in the VPS volume.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
